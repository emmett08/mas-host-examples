{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "diagnostic",
        "http"
      ]
    },
    "rationale": {
      "type": "string",
      "maxLength": 2000
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 12
    },
    "program": {
      "type": "string",
      "maxLength": 5000
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "expectedStatus": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "expectedStatus"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    }
  },
  "required": [
    "kind",
    "rationale",
    "predictions",
    "program",
    "requests"
  ],
  "additionalProperties": false
}
