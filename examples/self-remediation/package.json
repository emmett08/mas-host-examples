{
  "name": "mas-self-remediation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vue-tsc --noEmit -p tsconfig.ui.json && vite build && node scripts/build-observer.mjs && node scripts/build-tools.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:host": "node --import tsx --test host/*.integration.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "verify:formal": "python3 verification/verify.py",
    "run": "node --import tsx scripts/run.ts",
    "observe:github": "node dist/server/index.js",
    "archive": "node scripts/archive.mjs",
    "publish": "node --import tsx scripts/publish.ts"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "vue": "3.5.44",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.27.3",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
