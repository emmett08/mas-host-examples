{
  "name": "mas-k3s-live-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.ui.json && tsc -p tsconfig.json && vite build",
    "archive": "node deploy/archive.mjs",
    "start": "node dist/server/index.js",
    "operator": "node dist/operator/index.js",
    "remediator": "node dist/remediator/index.js",
    "test": "node --import tsx --test server/*.test.ts operator/*.test.ts remediator/*.test.ts ui/*.test.ts deploy/*.test.mjs mcp/*.test.ts",
    "test:host": "node --import tsx --test server/*.integration.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "vue": "3.5.44",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
